# Backend secrets for LOCAL development (Firebase emulator) only.
#
# HOW TO USE
#   cp .secret.local.example .secret.local
#   then paste your real key below.
# The Firebase emulator reads secret values from `functions/.secret.local`.
# `.secret.local` is gitignored, so your key is never committed.
#
# PRODUCTION does NOT use this file. Set the deployed secret instead with:
#   firebase functions:secrets:set OPENAI_API_KEY

OPENAI_API_KEY=sk-your-openai-key-here
