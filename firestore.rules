rules_version = '2';

// The app talks to Firestore directly only for the user's own saved lists. Everything else
// (the places cache, and the users/{uid} doc holding metering + subscription state) is written
// exclusively by the Cloud Functions via the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user may READ their own usage/subscription doc (to show days-left), but never
    // write it — metering + subscription are set only by the Cloud Functions (Admin SDK).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // A signed-in user (anonymous counts) may read/write only their own to-do lists.
    match /users/{uid}/lists/{listId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny all other direct client access (the parent users/{uid} doc, places cache, etc.).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
