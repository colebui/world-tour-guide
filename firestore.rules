rules_version = '2';

// Phase 1: the iOS app does NOT talk to Firestore directly — only the Cloud Function
// (which uses the Admin SDK and bypasses these rules) reads/writes the cache.
// So we deny all direct client access. We'll open specific paths in Phase 5 when the
// app gains Firebase Auth + user documents.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
